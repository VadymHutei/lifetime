ENVIRONMENT=development
SERVICE_URL=http://127.0.0.1:8057
# Persistent local directory. Container default is /var/lib/lifetime.
# LIFETIME_DATA_DIR=./instance
# Production requires a generated secret (at least 32 characters).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
ANALYTICS_SECRET=
ANALYTICS_STORE_RAW_IP=false
ANALYTICS_RETENTION_DAYS=90
ANALYTICS_RAW_IP_DAYS=7
ANALYTICS_AGGREGATE_DAYS=365
# Only actual reverse-proxy networks; empty means trust none.
TRUSTED_PROXY_CIDRS=
