ENVIRONMENT=development
SERVICE_URL=http://127.0.0.1:8057
# MySQL 8.4 LTS: one database, separate reference/analytics tables.
DB_BACKEND=mysql
# Native Python: 127.0.0.1; Docker: server DNS or host.docker.internal.
# For compose.mysql.yaml local profile the app uses the mysql service automatically.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=lifetime
DB_USER=lifetime
# Fill locally. Use single quotes for passwords containing $ or # in Compose .env.
DB_PASSWORD=
# Optional CA certificate path as seen INSIDE the app/container; enables verified TLS.
# Mount your CA read-only before setting this. Both certificate and hostname are checked.
DB_SSL_CA=

# Persistent directory for analytics spool/local key (also used with MySQL).
# Container default is /var/lib/lifetime.
# LIFETIME_DATA_DIR=./instance
# Optional advanced overrides for separate MySQL databases; use URL-encoded passwords.
# REFERENCE_DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/lifetime_reference?charset=utf8mb4
# ANALYTICS_DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/lifetime_analytics?charset=utf8mb4
# Optional local SQLite compatibility: DB_BACKEND=sqlite (no username/password).
# SQLite defaults to two files inside LIFETIME_DATA_DIR; absolute Linux examples:
# REFERENCE_DATABASE_URL=sqlite:////var/lib/lifetime/reference.sqlite3
# ANALYTICS_DATABASE_URL=sqlite:////var/lib/lifetime/analytics.sqlite3

# Production requires a generated secret (at least 32 characters).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
ANALYTICS_SECRET=
ANALYTICS_STORE_RAW_IP=false
ANALYTICS_RETENTION_DAYS=90
ANALYTICS_RAW_IP_DAYS=7
ANALYTICS_AGGREGATE_DAYS=365
# Only actual reverse-proxy networks; empty means trust none.
TRUSTED_PROXY_CIDRS=
